<?xml version="1.0" encoding="utf-8"?>
<!-- One row in the settings dialog, sidebar or content. Same look as the Inputs dropdown rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="@drawable/input_row_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:tint="@drawable/pill_text"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="12dp"
        android:textColor="@drawable/pill_text"
        android:duplicateParentState="true"
        android:textSize="15sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/badge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:gravity="center"
        android:background="@drawable/badge_bg"
        android:textColor="@drawable/badge_text"
        android:duplicateParentState="true"
        android:textSize="12sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 600"
        android:includeFontPadding="false"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_check"
        android:tint="@drawable/pill_text"
        android:duplicateParentState="true"
        android:visibility="gone"
        android:contentDescription="@null" />
</LinearLayout>
