<?xml version="1.0" encoding="utf-8"?>
<!-- A Control Center switch: a round button (activated = on, a white ring = focused) and its name below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="4dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:padding="20dp"
        android:background="@drawable/cc_switch_bg"
        android:tint="@color/menu_on_accent"
        android:focusable="true"
        android:clickable="true" />

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:textColor="@color/menu_text"
        android:textSize="11sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
