<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher settings, full screen straight over the wallpaper (nothing darkens it): the sections on the left
  and the focused section's options on the right.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- The home wallpaper, or the wallpaper being previewed in the picker. -->
    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="34dp"
        android:paddingBottom="28dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/on_wall"
            android:textSize="40sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:letterSpacing="-0.02"
            android:shadowColor="@color/on_wall_shadow"
            android:shadowRadius="12"
            android:shadowDy="2"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="22dp"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Sections. Moving through them shows each one's options on the right. -->
            <com.gathin.tvhome.FadeFrame
                android:id="@+id/sectionsFrame"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="31">

                <com.gathin.tvhome.RoomyScrollView
                    android:id="@+id/sectionsScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:overScrollMode="never"
                    android:requiresFadingEdge="vertical"
                    android:fadingEdgeLength="80dp">

                    <LinearLayout
                        android:id="@+id/sections"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </com.gathin.tvhome.RoomyScrollView>
            </com.gathin.tvhome.FadeFrame>

            <Space
                android:layout_width="36dp"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="69"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sectionHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:textColor="@color/on_wall"
                    android:textSize="15sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/outfit" />

                <com.gathin.tvhome.FadeFrame
                    android:id="@+id/rowsFrame"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <com.gathin.tvhome.RoomyScrollView
                        android:id="@+id/scroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="none"
                        android:overScrollMode="never"
                        android:requiresFadingEdge="vertical"
                        android:fadingEdgeLength="80dp"
                        android:clipToPadding="false"
                        android:paddingTop="4dp"
                        android:paddingBottom="24dp">

                        <LinearLayout
                            android:id="@+id/rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:clipChildren="false"
                            android:clipToPadding="false" />
                    </com.gathin.tvhome.RoomyScrollView>
                </com.gathin.tvhome.FadeFrame>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
