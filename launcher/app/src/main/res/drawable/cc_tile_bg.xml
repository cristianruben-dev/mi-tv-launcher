<?xml version="1.0" encoding="utf-8"?>
<!-- Control Center tile: the menu's tile fill; focus adds a white ring and keeps the fill, like the switches. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/menu_tile_focused" />
            <stroke android:width="2.5dp" android:color="@color/menu_focus" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/menu_tile" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
