<?xml version="1.0" encoding="utf-8"?>
<!--
  A duration in the Control Center's choices card: blue for the one in use, frosted for the rest. Focus adds
  a white ring and keeps the fill, like the switches and tiles.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF0A84FF" />
            <stroke android:width="2.5dp" android:color="#F5FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <stroke android:width="2.5dp" android:color="#F5FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF0A84FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#24FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
