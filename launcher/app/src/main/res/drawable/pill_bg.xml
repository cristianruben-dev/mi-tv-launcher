<?xml version="1.0" encoding="utf-8"?>
<!-- The top bar's pills: the launcher's glass (Glass.java), the focus colour when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_focus" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#38FFFFFF" android:endColor="#1EFFFFFF" />
            <stroke android:width="1dp" android:color="#45FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
