<?xml version="1.0" encoding="utf-8"?>
<!-- On/off switch for settings rows: activated = on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FF34C759" />
                    <corners android:radius="14dp" />
                    <size android:width="50dp" android:height="28dp" />
                </shape>
            </item>
            <item android:left="24dp" android:top="2dp" android:bottom="2dp" android:right="2dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#59808088" />
                    <corners android:radius="14dp" />
                    <size android:width="50dp" android:height="28dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:bottom="2dp" android:right="24dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
